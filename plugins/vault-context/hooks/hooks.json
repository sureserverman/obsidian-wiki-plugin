{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\""
          },
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/stack-context.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
